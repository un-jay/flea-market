# Render + Neon(PostgreSQL)本番環境用の環境変数チェックリスト
#
# このファイルはコミットしても問題ない「値の入っていないテンプレート」です。
# 実際の値はRenderの環境変数設定画面で入力してください（このファイルはコピーして使う想定はありません）。

APP_NAME=flea-market
APP_ENV=production
APP_KEY=
# php artisan key:generate --show でローカル生成した値をRenderに設定する
APP_DEBUG=false
APP_URL=

LOG_CHANNEL=stack
LOG_LEVEL=error

# NeonのPostgreSQL接続情報
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# NeonはSSL必須。未設定でもconfig/database.phpのデフォルトでrequireになる
DB_SSLMODE=require

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
